<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sky.mapper.SetmealDishMapper">

    <resultMap id="BaseResultMap" type="com.sky.entity.SetmealDish">
        <id column="id" property="id"/>
        <result column="setmeal_id" property="setmealId"/>
        <result column="dish_id" property="dishId"/>
        <result column="name" property="name"/>
        <result column="price" property="price"/>
        <result column="copies" property="copies"/>
    </resultMap>

    <insert id="insert" parameterType="com.sky.entity.SetmealDish" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO setmeal_dish (setmeal_id, dish_id, name, price, copies)
        VALUES (#{setmealId}, #{dishId}, #{name}, #{price}, #{copies})
    </insert>

    <select id="existsBySetmealIdAndDishId" resultType="java.lang.Boolean">
        SELECT COUNT(1) > 0
        FROM setmeal_dish
        WHERE setmeal_id = #{setmealId}
          AND dish_id = #{dishId}
    </select>

    <!-- 如需批量插入（效率更高），可参考下面注释代码并按需启用
    <insert id="insertBatch" parameterType="java.util.List">
      INSERT INTO setmeal_dish (setmeal_id, dish_id, name, price, copies)
      VALUES
      <foreach collection="list" item="item" separator=",">
        (#{item.setmealId}, #{item.dishId}, #{item.name}, #{item.price}, #{item.copies})
      </foreach>
    </insert>
    -->
</mapper>
