<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.sky.mapper.AiTaskMapper">

    <sql id="Base_Columns">
        id, user_id, order_ids, status, payload, response_raw, create_time, update_time
    </sql>
    <resultMap id="AiTaskResultMap" type="com.sky.entity.AiTask">
        <id column="id" property="id" jdbcType="BIGINT"/>
        <result column="user_id" property="userId" jdbcType="BIGINT"/>
        <result column="order_ids" property="orderIds" jdbcType="LONGVARCHAR"/>
        <result column="status" property="status" jdbcType="VARCHAR"/>
        <result column="payload" property="payload" jdbcType="LONGVARCHAR"/>
        <result column="response_raw" property="responseRaw" jdbcType="LONGVARCHAR"/>
        <result column="create_time" property="createTime" jdbcType="TIMESTAMP"/>
        <result column="update_time" property="updateTime" jdbcType="TIMESTAMP"/>
    </resultMap>



    <insert id="insert" parameterType="com.sky.entity.AiTask" useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        INSERT INTO ai_task (user_id, order_ids, status, payload, response_raw, create_time, update_time)
        VALUES (
                   #{userId,jdbcType=BIGINT},
                   #{orderIds,jdbcType=LONGVARCHAR},
                   #{status,jdbcType=VARCHAR},
                   #{payload,jdbcType=LONGVARCHAR},
                   #{responseRaw,jdbcType=LONGVARCHAR},
                   NOW(),
                   NOW()
               )
    </insert>

    <update id="update" parameterType="com.sky.entity.AiTask">
        UPDATE ai_task
        <set>
            <if test="userId != null">user_id = #{userId,jdbcType=BIGINT},</if>
            <if test="orderIds != null">order_ids = #{orderIds,jdbcType=LONGVARCHAR},</if>
            <if test="status != null">status = #{status,jdbcType=VARCHAR},</if>
            <if test="payload != null">payload = #{payload,jdbcType=LONGVARCHAR},</if>
            <if test="responseRaw != null">response_raw = #{responseRaw,jdbcType=LONGVARCHAR},</if>
            update_time = NOW()
        </set>
        WHERE id = #{id,jdbcType=BIGINT}
    </update>

    <select id="selectById" resultMap="AiTaskResultMap" parameterType="long">
        SELECT <include refid="Base_Columns" /> FROM ai_task WHERE id = #{id}
    </select>

    <select id="selectByUserId" resultMap="AiTaskResultMap" parameterType="long">
        SELECT <include refid="Base_Columns" /> FROM ai_task
        WHERE user_id = #{userId}
        ORDER BY create_time DESC
    </select>

    <select id="selectByStatus" resultMap="AiTaskResultMap" parameterType="string">
        SELECT <include refid="Base_Columns" /> FROM ai_task
        WHERE status = #{status}
        ORDER BY create_time DESC
    </select>

    <delete id="deleteById" parameterType="long">
        DELETE FROM ai_task WHERE id = #{id}
    </delete>

</mapper>
