{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SetmealSuggestions",
  "type": "object",
  "properties": {
    "suggestions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "suggestion_id": { "type": "string", "description": "可选：建议内部 id / trace" },
          "setmealName": { "type": "string" },
          "dishIds": {
            "type": "array",
            "items": { "type": "integer", "minimum": 1 }
          },
          "quantity": { "type": "integer", "minimum": 1 },
          "totalPrice": { "type": "number", "minimum": 0 },
          "note": { "type": "string" }
        },
        "required": ["setmealName", "dishIds", "quantity", "totalPrice"]
      }
    }
  },
  "required": ["suggestions"]
}
